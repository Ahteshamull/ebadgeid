# Browser-facing helpdesk API. Use /api so Next.js can proxy to help_backend
# (avoids CORS). For a direct backend URL: http://localhost:8000/api
NEXT_PUBLIC_HELPDESK_API_URL=/api
NEXT_PUBLIC_HELPDESK_WS_URL=ws://localhost:8000
NEXT_PUBLIC_CORE_API_URL=http://localhost:5000
# Must match a real Organizations.organization_code in help_backend MongoDB
# (and usually help_backend DEFAULT_ORG_CODE).
NEXT_PUBLIC_ORGANIZATION_CODE=local-dev-org
NEXT_PUBLIC_UPLOAD_BASE_URL=http://localhost:9000
# Server-only rewrite target used when NEXT_PUBLIC_HELPDESK_API_URL is relative.
HELPDESK_BACKEND_URL=http://localhost:8000
